{
  "name": "controle-gastos-mensais",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch backend/src/server.ts",
    "start:api": "node backend/dist/server.js",
    "build:api": "prisma generate && tsc -p backend/tsconfig.json",
    "build": "npm run build:api && vite build",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.12",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "6.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
